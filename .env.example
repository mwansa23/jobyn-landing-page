# Jobyn landing page (Vite) environment variables.
# Copy to `.env` (local) or configure the matching keys in your hosting dashboard.

# Base URL of the Jobyn FastAPI backend.
# Local development can override the deployed API with http://127.0.0.1:8000.
VITE_API_BASE_URL=http://127.0.0.1:8000

# Supabase project credentials (Project Settings -> API).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
